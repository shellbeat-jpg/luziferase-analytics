# Vorlage nach dem Breviarium-Muster (siehe cloud_breviarium.conf):
# eigene Subdomain, eigenes Let's-Encrypt-Zertifikat, Proxy auf lokalen Port.
#
# Einrichtung (Übersicht, keine Befehle blind ausführen -- an echte Pfade/Domain anpassen):
#   1. Datei nach /etc/nginx/sites-available/analytics_luziferase.conf kopieren
#   2. Domain unten anpassen (Vorschlag: analytics.luziferase.de)
#   3. certbot fuer die neue Subdomain laufen lassen (separates Zertifikat, wie bei
#      cloud.breviarium.de), NICHT das bestehende Luziferase-Zertifikat wiederverwenden
#   4. Symlink nach sites-enabled, `nginx -t && systemctl reload nginx`
#
# Risiko-Einschätzung: niedrig -- neue, eigenständige Server-Block-Datei, keine
# Änderung an bestehenden Luziferase-/Breviarium-Configs.

server {
    listen 80;
    server_name analytics.luziferase.de;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name analytics.luziferase.de;

    ssl_certificate     /etc/letsencrypt/live/analytics.luziferase.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/analytics.luziferase.de/privkey.pem;

    # FastAPI-Backend (docker-compose bindet an 127.0.0.1:8100)
    location /api/ {
        proxy_pass http://127.0.0.1:8100/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Next.js-Frontend (Woche 4) -- Port folgt, sobald das Frontend steht
    location / {
        proxy_pass http://127.0.0.1:3100/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
