# Kopieren nach ~/.dbt/profiles.yml (oder DBT_PROFILES_DIR setzen), Werte aus .env übernehmen.
luziferase_analytics:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost   # lokal: localhost (via docker-compose.dev.yml Port 5433)
                         # auf dem Server: db (Docker-Netzwerkname) bzw. Container-IP
      port: 5433
      user: analytics
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      dbname: luziferase_analytics
      schema: dbt_dev
      threads: 4
