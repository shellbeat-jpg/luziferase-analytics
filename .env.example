# Kopieren nach .env und Werte anpassen. .env NIEMALS committen (siehe .gitignore).

POSTGRES_DB=luziferase_analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Von der FastAPI-App verwendet (SQLAlchemy async URL, asyncpg-Treiber)
DATABASE_URL=postgresql+asyncpg://analytics:change-me-to-a-strong-password@db:5432/luziferase_analytics

# Last.fm API (nur Read-Zugriff -> reicht ein einfacher API-Key, kein Session-Key-Flow noetig)
LASTFM_API_KEY=

# Simulierte Station(en), Komma-getrennt (Shortcodes wie in AzuraCast)
MOCK_STATIONS=luziferase,modular,bass

# Poll-Intervall des async Ingestion-Workers in Sekunden
INGESTION_POLL_INTERVAL_SECONDS=30
